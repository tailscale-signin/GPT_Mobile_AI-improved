AMAZON_MCP_ENTRY=/absolute/path/to/amazon-mcp/dist/index.js
AMAZON_MCP_TOKEN=
AMAZON_MCP_HOST=127.0.0.1
AMAZON_MCP_PORT=8111
AMAZON_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
AMAZON_DEFAULT_MARKETPLACE=CA
