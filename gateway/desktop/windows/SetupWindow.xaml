<Window x:Class="GatewayDesktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up GPT Mobile Gateway" Width="830" Height="610" MinWidth="610" MinHeight="460"
        UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="15">

  <Grid Margin="28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,14">
      <TextBlock x:Name="StepNumber" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
      <Image Source="gateway.png" Width="32" Height="32" Margin="0,0,12,0" DockPanel.Dock="Left" />
      <TextBlock VerticalAlignment="Center" Text="GPT Mobile Gateway" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="20" Padding="24">
      <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="Heading" Focusable="True" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,16"/>
          <StackPanel x:Name="EditionPage">
            <RadioButton x:Name="Standard" IsChecked="True" Content="Gateway"/>
            <TextBlock Margin="22,0,0,12" Foreground="{DynamicResource MutedBrush}" Text="Connect your phone for chat and repository work."/>
            <RadioButton x:Name="Engineering" Content="Also set up local build tools"/>
            <TextBlock Margin="22,0,0,12" Foreground="{DynamicResource MutedBrush}" Text="Also open the Git, WSL and Docker setup assistant for isolated repository tests."/>
          </StackPanel>
          <StackPanel x:Name="ConnectionPage" Visibility="Collapsed">
            <Label Target="{Binding ElementName=Backend}" Foreground="{DynamicResource TextBrush}" Content="Model _backend origin"/>
            <TextBox x:Name="Backend" Text="http://127.0.0.1:8080" Padding="8" MaxLength="512"/>
            <Label Target="{Binding ElementName=Port}" Foreground="{DynamicResource TextBrush}" Content="Gateway _port"/>
            <TextBox x:Name="Port" Text="8090" Padding="8" MaxLength="5"/>
            <Label Target="{Binding ElementName=Listener}" Foreground="{DynamicResource TextBrush}" Content="_Listen on"/>
            <ComboBox x:Name="Listener" DisplayMemberPath="Label" Padding="8"/>
            <TextBlock x:Name="ListenerHint" Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}"/>
          </StackPanel>
          <StackPanel x:Name="ChecksPage" Visibility="Collapsed">
            <TextBlock x:Name="Checks" LineHeight="25" AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="Retry" HorizontalAlignment="Left" Margin="0,16,0,0" Content="Check again" Click="RetryChecks"/>
          </StackPanel>
          <StackPanel x:Name="FinishPage" Visibility="Collapsed">
            <TextBlock x:Name="Summary" LineHeight="23"/>
            <Label Target="{Binding ElementName=Updates}" Foreground="{DynamicResource TextBrush}" Content="_Stable updates"/>
            <ComboBox x:Name="Updates" SelectedIndex="0">
              <ComboBoxItem Content="Notify when available"/>
              <ComboBoxItem Content="Automatically install when idle"/>
              <ComboBoxItem Content="Only check manually"/>
            </ComboBox>
            <CheckBox x:Name="Advanced" Content="Advanced settings"/>
            <StackPanel>
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=Advanced}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></StackPanel.Style>
              <Label Target="{Binding ElementName=Mcp}" Foreground="{DynamicResource TextBrush}" Content="Existing _MCP configuration file (optional)"/>
              <TextBox x:Name="Mcp" MaxLength="2048"/>
              <Label Target="{Binding ElementName=Workers}" Foreground="{DynamicResource TextBrush}" Content="Concurrent _workers (1–16)"/>
              <TextBox x:Name="Workers" Text="2" MaxLength="2"/>
              <Label Target="{Binding ElementName=Chats}" Foreground="{DynamicResource TextBrush}" Content="Maximum admitted _chats (workers–64)"/>
              <TextBox x:Name="Chats" Text="8" MaxLength="2"/>
              <Label Target="{Binding ElementName=Grace}" Foreground="{DynamicResource TextBrush}" Content="_Shutdown grace in seconds (10–120)"/>
              <TextBox x:Name="Grace" Text="30" MaxLength="3"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="Problem" Margin="0,14,0,0" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel>
      </ScrollViewer>
    </Border>
    <DockPanel Grid.Row="2" Margin="0,16,0,0">
      <Button x:Name="Next" DockPanel.Dock="Right" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="NextPage"/>
      <Button x:Name="Back" HorizontalAlignment="Left" Content="_Back" Click="PreviousPage"/>
    </DockPanel>
  </Grid>
</Window>
