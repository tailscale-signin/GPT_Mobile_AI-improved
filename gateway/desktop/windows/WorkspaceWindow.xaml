<Window x:Class="GatewayDesktop.WorkspaceWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="GPT Mobile Gateway" Width="1080" Height="730" MinWidth="620" MinHeight="450"
 WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="15"
 Foreground="{DynamicResource TextBrush}" Background="{DynamicResource CanvasBrush}">
 <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border CornerRadius="18" Background="{DynamicResource PanelBrush}" Padding="13">
   <DockPanel><TextBlock DockPanel.Dock="Top" Text="GPT Mobile&#10;Gateway" Margin="8,8,0,20" FontSize="23" FontWeight="SemiBold"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" Margin="20,4,2,0" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="TitleText" FontSize="34" FontWeight="SemiBold"/>
   <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" AutomationProperties.LiveSetting="Polite"/>
   <Border CornerRadius="18" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource PanelBrush}" Padding="22">
    <StackPanel><TextBlock x:Name="Section" FontWeight="SemiBold" FontSize="20"/>
     <TextBlock x:Name="Summary" Margin="0,10,0,13" TextWrapping="Wrap" LineHeight="25"/>
     <Button x:Name="Action" HorizontalAlignment="Left" Click="OpenWorkspace" Padding="16,9"/>
    </StackPanel>
   </Border>
   <Border x:Name="PreviewCard" Margin="0,14,0,0" CornerRadius="18" Padding="20" Background="{DynamicResource PanelBrush}">
    <StackPanel><TextBlock x:Name="ListHeading" FontWeight="SemiBold" FontSize="18"/>
     <TextBlock x:Name="Details" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="24"/>
    </StackPanel>
   </Border>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
