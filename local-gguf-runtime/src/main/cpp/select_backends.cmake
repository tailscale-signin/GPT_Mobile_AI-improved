# The pinned registry eagerly probes every compiled accelerator. Keep CPU startup
# independent of vendor drivers; JNI explicitly registers only the selected GPU.
set(registry "${SOURCE_DIR}/ggml/src/ggml-backend-reg.cpp")
file(READ "${registry}" original)
set(patched "${original}")
foreach(backend vk opencl)
    set(needle "register_backend(ggml_backend_${backend}_reg());")
    set(replacement "/* GPTMobile: explicit ${backend} registration in JNI. */")
    string(FIND "${patched}" "${needle}" found)
    string(FIND "${patched}" "${replacement}" already_patched)
    if(found EQUAL -1 AND already_patched EQUAL -1)
        message(FATAL_ERROR "Pinned backend registry changed: ${backend}")
    endif()
    string(REPLACE "${needle}" "${replacement}" patched "${patched}")
endforeach()
if(NOT patched STREQUAL original)
    file(WRITE "${registry}" "${patched}")
endif()

# Instrument the exact selected backend without globally intercepting OpenCL.
set(opencl "${SOURCE_DIR}/ggml/src/ggml-opencl/ggml-opencl.cpp")
file(READ "${opencl}" opencl_original)
set(opencl_marker "#include \"gptmobile-opencl-trace.h\"")
string(FIND "${opencl_original}" "${opencl_marker}" opencl_patched)
if(opencl_patched EQUAL -1)
    set(opencl_needle "#include <CL/cl.h>")
    string(FIND "${opencl_original}" "${opencl_needle}" opencl_found)
    if(opencl_found EQUAL -1)
        message(FATAL_ERROR "Pinned OpenCL declarations changed")
    endif()
    string(REPLACE "${opencl_needle}" "${opencl_needle}\n${opencl_marker}" opencl_content "${opencl_original}")
    file(WRITE "${opencl}" "${opencl_content}")
endif()
configure_file("${CMAKE_CURRENT_LIST_DIR}/gguf_opencl_trace.h" "${SOURCE_DIR}/ggml/src/ggml-opencl/gptmobile-opencl-trace.h" COPYONLY)
