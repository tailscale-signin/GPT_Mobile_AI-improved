{
  "problemMatcher": [
    {
      "owner": "gradle",
      "pattern": [
        {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "gradle-ksp-compiler",
      "pattern": [
        {
          "regexp": "^e:\\s+(.*):\\s*(\\d+):(\\d+)\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": "error",
          "message": 4
        }
      ]
    }
  ]
}
