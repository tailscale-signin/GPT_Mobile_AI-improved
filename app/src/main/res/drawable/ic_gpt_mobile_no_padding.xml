<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="36dp"
    android:height="36dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Cyan circular background -->
    <path
        android:fillColor="#17C5D7"
        android:pathData="M 50,0
                         A 50,50 0 1,1 50,100
                         A 50,50 0 1,1 50,0 Z" />

    <!-- Centered Icon group -->
    <group
        android:translateX="50"
        android:translateY="50">

        <!-- Outer white chat bubble badge -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M -23,-21
                             L 27,-23
                             C 28,-23 29,-22 29,-21
                             L 20,23
                             C 20,24 19,25 18,25
                             L 20,34
                             L 8,24
                             L -27,22
                             C -28,22 -29,21 -29,20
                             L -24,-20
                             C -24,-21 -23,-21 -23,-21 Z" />

        <!-- Left ear / side antenna -->
        <path
            android:fillColor="#343B45"
            android:pathData="M -16,-6
                             C -17.5,-6 -18,-4.5 -18,-2
                             L -18,2
                             C -18,4.5 -17.5,6 -16,6
                             Z" />

        <!-- Right ear / side antenna -->
        <path
            android:fillColor="#343B45"
            android:pathData="M 16,-6
                             C 17.5,-6 18,-4.5 18,-2
                             L 18,2
                             C 18,4.5 17.5,6 16,6
                             Z" />

        <!-- Central cyan robot screen/face -->
        <path
            android:fillColor="#17C5D7"
            android:pathData="M -11,-11
                             H 11
                             V 11
                             H -11
                             Z" />

        <!-- Left eye -->
        <path
            android:fillColor="#343B45"
            android:pathData="M -4.5,-2
                             A 2.5,2.5 0 1,1 -4.5,3
                             A 2.5,2.5 0 1,1 -4.5,-2 Z" />

        <!-- Right eye -->
        <path
            android:fillColor="#343B45"
            android:pathData="M 4.5,-2
                             A 2.5,2.5 0 1,1 4.5,3
                             A 2.5,2.5 0 1,1 4.5,-2 Z" />
    </group>
</vector>
