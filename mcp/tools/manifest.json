{
  "manifest_version": "1.0",
  "name": "GPT Mobile Built-in MCP Tools",
  "version": "0.9.5.6",
  "description": "Pre-bundled Model Context Protocol tool catalog and definitions for GPT Mobile AI",
  "triple_verification": {
    "enabled": true,
    "manifest_check": true,
    "sha_check": true,
    "read_after_write": true
  },
  "tools": [
    {
      "name": "read_file",
      "category": "FILE_SYSTEM",
      "description": "Read content from a local file",
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "File path to read" }
      ]
    },
    {
      "name": "write_file",
      "category": "FILE_SYSTEM",
      "description": "Write content to a local file",
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "File path" },
        { "name": "content", "type": "string", "required": true, "description": "Content to write" }
      ]
    },
    {
      "name": "list_directory",
      "category": "FILE_SYSTEM",
      "description": "List contents of a directory",
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "Directory path" }
      ]
    },
    {
      "name": "delete_file",
      "category": "FILE_SYSTEM",
      "description": "Delete a file (requires confirmation)",
      "parameters": [
        { "name": "path", "type": "string", "required": true, "description": "File path to delete" }
      ]
    },
    {
      "name": "execute_code",
      "category": "CODE_EXECUTION",
      "description": "Execute Python/JavaScript code snippets",
      "parameters": [
        { "name": "code", "type": "string", "required": true, "description": "Code to execute" },
        { "name": "language", "type": "string", "required": false, "description": "Programming language" }
      ]
    },
    {
      "name": "query_database",
      "category": "DATABASE",
      "description": "Query SQLite/Room database with parameterized queries and safety guards",
      "parameters": [
        { "name": "sql", "type": "string", "required": true, "description": "SQL query or statement to execute" },
        { "name": "params", "type": "array", "required": false, "description": "Optional parameterized query arguments" },
        { "name": "database_path", "type": "string", "required": false, "description": "Optional custom database path" },
        { "name": "read_only", "type": "boolean", "required": false, "description": "Whether mutation statements are blocked (default true)" }
      ]
    },
    {
      "name": "http_request",
      "category": "NETWORK",
      "description": "Make HTTP requests (GET/POST/PUT/DELETE)",
      "parameters": [
        { "name": "url", "type": "string", "required": true, "description": "Target URL" },
        { "name": "method", "type": "string", "required": false, "description": "HTTP method" },
        { "name": "headers", "type": "object", "required": false, "description": "Request headers" },
        { "name": "body", "type": "string", "required": false, "description": "Request body" }
      ]
    },
    {
      "name": "translate_text",
      "category": "TRANSLATION",
      "description": "Translate text between languages",
      "parameters": [
        { "name": "text", "type": "string", "required": true, "description": "Text to translate" },
        { "name": "source_lang", "type": "string", "required": false, "description": "Source language code" },
        { "name": "target_lang", "type": "string", "required": true, "description": "Target language code" }
      ]
    },
    {
      "name": "geolocate_ip",
      "category": "LOCATION",
      "description": "Look up geolocation data for an IP address (auto-detect if omitted)",
      "parameters": [
        { "name": "ip", "type": "string", "required": false, "description": "IP address to lookup (auto-detect host IP if omitted)" }
      ]
    },
    {
      "name": "reverse_geocode",
      "category": "LOCATION",
      "description": "Convert latitude/longitude coordinates to human-readable address",
      "parameters": [
        { "name": "latitude", "type": "number", "required": true, "description": "Latitude coordinate (-90 to 90)" },
        { "name": "longitude", "type": "number", "required": true, "description": "Longitude coordinate (-180 to 180)" }
      ]
    },
    {
      "name": "get_current_location",
      "category": "LOCATION",
      "description": "Get current GPS location from device (requires Android/iOS native bridge)",
      "parameters": []
    },
    {
      "name": "geocode_address",
      "category": "LOCATION",
      "description": "Convert a street address or location name into geographic coordinates (latitude and longitude)",
      "parameters": [
        { "name": "address", "type": "string", "required": true, "description": "Address or place name to geocode" }
      ]
    },
    {
      "name": "calculate_distance",
      "category": "LOCATION",
      "description": "Calculate great-circle distance between two geographic coordinates using the Haversine formula",
      "parameters": [
        { "name": "lat1", "type": "number", "required": true, "description": "Latitude of starting location" },
        { "name": "lon1", "type": "number", "required": true, "description": "Longitude of starting location" },
        { "name": "lat2", "type": "number", "required": true, "description": "Latitude of destination location" },
        { "name": "lon2", "type": "number", "required": true, "description": "Longitude of destination location" }
      ]
    },
    {
      "name": "fetch",
      "category": "WEB",
      "description": "Download HTML web pages and parse to clean Markdown",
      "parameters": [
        { "name": "url", "type": "string", "required": true, "description": "URL of the webpage to fetch" }
      ]
    },
    {
      "name": "extract_links",
      "category": "WEB",
      "description": "Extract outbound hyperlinks from a webpage URL",
      "parameters": [
        { "name": "url", "type": "string", "required": true, "description": "URL of the webpage to extract links from" }
      ]
    }
  ]
}
