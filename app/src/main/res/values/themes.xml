<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Proxima Nova Font Family -->
    <string name="font_proxima_nova">@font/proxima_nova_regular</string>

    <!-- Material 3 Typography - Proxima Nova -->
    <style name="MaterialTheme.typography.displayLarge" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">57sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.16em</item>
    </style>

    <style name="MaterialTheme.typography.headlineLarge" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.15em</item>
    </style>

    <style name="MaterialTheme.typography.headlineMedium" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.15em</item>
    </style>

    <style name="MaterialTheme.typography.headlineSmall" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.16em</item>
    </style>

    <style name="MaterialTheme.typography.titleLarge" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.16em</item>
    </style>

    <style name="MaterialTheme.typography.titleMedium" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.15em</item>
    </style>

    <style name="MaterialTheme.typography.titleSmall" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.1em</item>
    </style>

    <style name="MaterialTheme.typography.bodyLarge" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="MaterialTheme.typography.bodyMedium" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="MaterialTheme.typography.bodySmall" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
    </style>

    <style name="MaterialTheme.typography.labelLarge" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.1em</item>
    </style>

    <style name="MaterialTheme.typography.labelMedium" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.1em</item>
    </style>

    <style name="MaterialTheme.typography.labelSmall" parent="android:Widget.Material3.TextView">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="android:letterSpacing">0.5em</item>
    </style>

    <!-- Material 3 Theme with Proxima Nova -->
    <style name="Theme.GPTMobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/proxima_nova_regular</item>
        <item name="colorPrimary">@color/ic_gpt_mobile_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/ic_gpt_mobile_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <item name="colorSecondary">@color/ic_gpt_mobile_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorTertiary">@color/ic_gpt_mobile_tertiary</item>
        <item name="colorOnTertiary">@color/black</item>
        <item name="android:windowBackground">@color/ic_gpt_mobile_background</item>
    </style>

    <!-- Manifest theme compatibility aliases -->
    <style name="Theme.Gptmobile" parent="Theme.GPTMobile" />

    <style name="Theme.Gptmobile.Translucent" parent="Theme.Gptmobile">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.GPTMobile.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/ic_gpt_mobile_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_inset</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_gpt_mobile_background</item>
        <item name="postSplashScreenTheme">@style/Theme.GPTMobile</item>
    </style>

</resources>
